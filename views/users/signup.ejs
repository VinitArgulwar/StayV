<% layout('layouts/boilerplate') %>

<div class="row mt-4 mb-5 justify-content-center">
    <div class="col-lg-5 col-md-8 col-sm-10 col-12">
        <div class="form-card signup-card">
            <!-- Decorative Accent Header -->
            <div class="signup-header-accent"></div>
            
            <div class="text-center mb-3 mt-2">
                <i class="fa-brands fa-airbnb signup-logo-icon"></i>
                <h2 class="fw-bold mt-2 mb-1">Create Traveler Account</h2>
                <p class="text-muted signup-subtext">Join StayV to explore stays and share your reviews</p>
            </div>

            <!-- Role Switch Tabs -->
            <div class="auth-role-tabs mb-4">
                <a href="/signup" class="auth-role-tab active">
                    <i class="fa-solid fa-user me-1"></i> Traveler
                </a>
                <a href="/signup/pm" class="auth-role-tab">
                    <i class="fa-solid fa-user-tie me-1"></i> Project Manager
                </a>
            </div>
            
            <form action="/signup" method="POST" novalidate class="needs-validation">
                <input type="hidden" name="role" value="user">

                <!-- Username -->
                <div class="mb-3">
                    <label for="username" class="form-label-custom">Username</label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="fa-solid fa-user"></i></span>
                        <input name="username" type="text" class="form-control-custom" id="username" placeholder="e.g. wanderer44" required>
                        <div class="invalid-feedback">Please choose a username.</div>
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label-custom">Email Address</label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
                        <input name="email" type="email" class="form-control-custom" id="email" placeholder="you@example.com" required>
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label for="password" class="form-label-custom">Password</label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                        <input name="password" type="password" class="form-control-custom" id="password" placeholder="••••••••" required>
                        <div class="invalid-feedback">Please enter a secure password.</div>
                    </div>
                </div>
                
                <div class="d-grid gap-2">
                    <button class="btn btn-brand py-2 btn-lg" type="submit">Sign Up as Traveler</button>
                    <div class="text-center mt-3">
                        <span class="text-muted small">Already have an account?</span>
                        <a href="/login" class="fw-bold text-decoration-none text-brand ms-1 small">Log In</a>
                    </div>
                    <a href="/listings" class="btn-link-back text-center mt-2 text-decoration-none">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Explore
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>