      </div>
      
      <div class="navbar-nav ms-auto align-items-center">
        <% if (currentUser && (currentUser.role === 'project_manager' || currentUser.role === 'host' || currentUser.role === 'admin')) { %>
          <a class="nav-link add-listing-nav-link me-2" href="/listings/new">
            <i class="fa-solid fa-plus-circle me-1"></i> Add Listing
          </a>
        <% } %>

        <% if (currentUser && currentUser.role === 'admin') { %>
          <a class="nav-link admin-nav-link me-2" href="/admin">
            <i class="fa-solid fa-shield-halved me-1"></i> Admin Panel
          </a>
        <% } %>

        <% if (!currentUser) { %>
