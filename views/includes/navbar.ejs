          <a class="btn btn-brand btn-sm px-3 ms-2 text-white" href="/signup"><b>Sign Up</b></a>
        <% } else { %>
          <div class="nav-item d-flex align-items-center me-3">
            <span class="nav-user-welcome me-2">Hi, <b><%= currentUser.username %></b></span>
