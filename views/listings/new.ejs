<% layout('layouts/boilerplate') %>

<div class="row mt-4 mb-5">
    <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12">
        <div class="form-card">
            <h3 class="mb-4 fw-bold text-center">Create a New Listing</h3>
            
            <form action="/listings" method="POST"  class="needs-validation" novalidate enctype="multipart/form-data">
                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">Listing Title</label>
                    <input name="listing[title]" placeholder="Give your place a catchy title" type="text" class="form-control" id="title" required >
                    <div class="valid-feedback">Title looks good!  </div>
                    
                </div>
                
                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="Write a short description about the amenities, location, etc." class="form-control" id="description" rows="4" required></textarea>
                 <div class="invalid-feedback">Please Enter a short description.</div>

                </div>
                
                <!-- Image -->
                <div class="mb-3">
                    <label for="image" class="form-label">Upload an Image</label>
                    <input name="listing[image]" type="file" class="form-control"/>
                    required
                </div>
                
                <div class="row">
                    <!-- Price -->
                    <div class="mb-3 col-md-4 col-12">
                        <label for="price" class="form-label">Price per Night</label>
                        <div class="input-group">
                            <span class="input-group-text">&#8377;</span>
                            <input name="listing[price]" placeholder="1200" type="number" class="form-control" id="price" required >
                        </div>
                        <div class="invalid-feedback">Please Enter a valid price.</div>
                    </div>
                    
                    <!-- Location -->
                    <div class="mb-3 col-md-4 col-12">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" placeholder="e.g. Goa, Jaipur" type="text" class="form-control" id="location" required>
                   <div class="invalid-feedback">Please Enter a valid location.</div>

                    </div>
                    
                    <!-- Country -->
                    <div class="mb-3 col-md-4 col-12">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" placeholder="e.g. India" type="text" class="form-control" id="country" required>
                    </div>
                    <div class="invalid-feedback">Please Enter a valid country.</div>

                </div>
                
                <div class="d-grid mt-4">
                    <button class="btn btn-brand py-2 btn-lg" type="submit">Create Listing</button>
                </div>
            </form>
        </div>
    </div>
</div>
